# Leave empty on Vercel when using vercel.json rewrites to the AWS API.
# Or set to a public HTTPS API origin later, e.g. https://api.yourdomain.com
# VITE_API_BASE=

# Dashboard base path (default /app/ in vite.config.js).
# On Vercel, leave unset — `npm run build` assembles marketing at / and the app at /app/.
# Do not set VITE_BASE_PATH=/ (that caused login-at-root / white-screen asset mismatches).
# VITE_BASE_PATH=/app/
